# Settings for the books service (QuickBooks portfolio monitor). Set these on the host
# (Render > oakridge-books > Environment). Never commit real values.

# --- Intuit developer app (developer.intuit.com), production keys ---
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_ENVIRONMENT=production    # or sandbox while testing
INTUIT_WEBHOOK_VERIFIER=         # from the app's Webhooks page

# --- Secrets this service owns ---
BOOKS_ACCESS_KEY=                # long random string: opens /books/connect and the MCP endpoint
BOOKS_TOKEN_KEY=                 # python -m books.keygen ; encrypts QuickBooks tokens at rest

# --- Claude (weekly scorecard write-up) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high

# --- Slack (can be the same app as the text bot; alerts go to this channel) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# --- Deployment ---
PUBLIC_BASE_URL=                 # e.g. https://oakridge-books.onrender.com
DB_PATH=/var/data/books.sqlite3
TIMEZONE=America/Chicago

# --- Optional tuning (defaults shown) ---
# ACCOUNTING_METHOD=             # Cash or Accrual; blank = each company's own report setting
# HISTORY_YEARS=2
# FULL_SYNC_HOURS=6
# WEBHOOK_DEBOUNCE_SECONDS=90
# SCORECARD_WEEKDAY=0            # 0 = Monday
# SCORECARD_HOUR=8
# ALERT_NOI_DROP_PCT=0.20
# ALERT_NOI_DROP_MIN=1000
# ALERT_REVENUE_DROP_PCT=0.15
# ALERT_REVENUE_DROP_MIN=500
# ALERT_EXPENSE_SPIKE_RATIO=2.0
# ALERT_EXPENSE_SPIKE_MIN=1000
# ALERT_UNCATEGORIZED_MIN=1
# ALERT_LOW_CASH=0
# ALERT_STALE_SYNC_HOURS=24
