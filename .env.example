# Copy to .env for local runs, or set these on the host (Render > Environment).
# Never commit real values.

# --- Behavior (safe defaults) ---
SHADOW_MODE=true                 # starting value; change later on the Settings page
AUTO_SEND_CATEGORIES=            # starting value; change later on the Settings page
TEST_NUMBERS=5403334014          # numbers that get real auto-replies even in shadow mode
STAFF_NUMBERS=                   # Kaori, Herlen, inspectors: never auto-replied to
DEBOUNCE_SECONDS=45
TIMEZONE=America/Chicago
QUIET_HOURS_START=21
QUIET_HOURS_END=8

# --- Claude ---
ANTHROPIC_API_KEY=

# --- RingCentral developer app (JWT auth) ---
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
RINGCENTRAL_WEBHOOK_TOKEN=       # any long random string; RingCentral echoes it on every webhook

# --- Rent Manager (read-only API user) ---
RM_BASE_URL=https://ndrellc.api.rentmanager.com
RM_USERNAME=
RM_PASSWORD=
RM_LOCATION_ID=1

# --- Alerts: texts to your cell when something needs approval ---
ALERT_NUMBERS=                   # your cell (comma-separate several). Text "PAUSE BOT" from it to pause.
ALERT_FROM_NUMBER=               # the park line alerts come from
ALERT_COOLDOWN_MINUTES=10

# --- Web app ---
SESSION_SECRET=                  # long random string; keeps people signed in across restarts
ADMIN_USERNAME=jeff              # first admin, created on first start if there are no users
ADMIN_PASSWORD=                  # 10+ characters; change it on the Settings page after first login

# --- Deployment ---
PUBLIC_BASE_URL=                 # e.g. https://oakridge-textbot.onrender.com
DB_PATH=/var/data/textbot.sqlite3
